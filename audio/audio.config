# Merge into the kernel configuration when porting to a different build.
CONFIG_MODULES=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_FSL_SAI=m
CONFIG_SND_SOC_IMX_PCM_DMA=y
CONFIG_SND_SOC_WM8960=y
CONFIG_I2C=y
CONFIG_I2C_IMX=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DMADEVICES=y
CONFIG_IMX_SDMA=m
CONFIG_FW_LOADER=y
